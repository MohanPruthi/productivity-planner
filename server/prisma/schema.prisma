datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Track {
  AI
  SD
}

enum PomodoroTrack {
  AI
  SD
  DSA
}

enum Difficulty {
  Easy
  Medium
  Hard
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  name             String
  workspacePin     String?           @default("1234")
  resetCodeHash    String?
  resetPurpose     String?
  resetExpiresAt   DateTime?
  resetAttempts    Int               @default(0)
  createdAt       DateTime          @default(now())
  plans            Plan[]
  planWeeks        PlanWeek[]
  planDays         PlanDay[]
  dsaLogs          DsaLog[]
  pomodoroSessions PomodoroSession[]
  dailyStudyLogs   DailyStudyLog[]
  normalTasks      NormalTask[]
  medSchedule      MedSchedule?
  medLogs          MedLog[]
  hrContacts       HrContact[]
  notes            Note[]
  noteGroups       NoteGroup[]
}

// A user-defined plan (e.g. "AI learning", "System design"). Its periods are PlanWeek rows.
model Plan {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String     @default("")
  color        String     @default("#6366f1")
  cadence      String     @default("weekly") // weekly | monthly
  layout       String     @default("daily")  // daily | split (weekday + weekend) | single
  weekdayHours Int?
  weekendHours Int?
  isPersonal   Boolean    @default(false)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  periods      PlanWeek[]

  @@index([userId])
}

// One period (week or month) of a plan. `track` is only set on rows from the old AI/SD plans.
model PlanWeek {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId     String?
  plan       Plan?     @relation(fields: [planId], references: [id], onDelete: Cascade)
  track      Track?
  weekNumber Int
  startDate  DateTime
  endDate    DateTime
  goalText   String
  planDays   PlanDay[]

  @@unique([userId, track, weekNumber])
  @@index([planId])
}

model PlanDay {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planWeekId     String
  planWeek       PlanWeek  @relation(fields: [planWeekId], references: [id], onDelete: Cascade)
  track          Track?
  date           DateTime
  dayLabel       String
  isWeekend      Boolean
  topic          String
  discussionNote String?
  isDone         Boolean   @default(false)

  @@index([userId, date])
  @@index([planWeekId])
}

model DsaLog {
  id             String     @id @default(uuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime
  questionNumber String
  difficulty     Difficulty
  title          String?
  titleSlug      String?
  topics         String[]   @default([])
  revisit        Boolean    @default(false)
  notes          String?
  createdAt      DateTime   @default(now())

  @@index([userId, date])
}

model PomodoroSession {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  track           PomodoroTrack?
  durationMinutes Int
  startedAt       DateTime
  completedAt     DateTime
  isCompleted     Boolean        @default(true)

  @@index([userId, completedAt])
}

model DailyStudyLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime // Normalized to midnight
  duration  Float    @default(0) // Duration in minutes studied

  @@unique([userId, date])
}

model NormalTask {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime // Normalized to midnight
  text      String
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model MedSchedule {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medName      String   @default("Daily Medication")
  startDate    DateTime @default(now())
  durationDays Int      @default(60)
}

model MedLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime // normalized to midnight YYYY-MM-DD
  morning   Boolean  @default(false)
  evening   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model HrContact {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactName     String
  phoneNumber     String?
  email           String?
  status          String    @default("Pending") // e.g. "Pending" | "Contacted" | "Interview Scheduled" | "Rejected" | "Offered"
  isContacted     Boolean   @default(false)
  interviewDate   DateTime?
  hrLinkedin      String?
  companyLinkedin String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}

model Note {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  content    String    @default("")
  type       String    @default("note") // "note" or "todo"
  checklist  Json?     @default("[]")
  colorTag   String    @default("#6366f1")
  isPersonal Boolean   @default(false)
  isPinned   Boolean   @default(false)
  pinnedAt   DateTime?
  groupId    String?
  group      NoteGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([groupId])
}

model NoteGroup {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("New group")
  sortOrder Int      @default(0)
  notes     Note[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
