DATABASE_URL=postgresql://postgres:postgres@localhost:5432/productivity_planner
JWT_SECRET=change-me
PORT=5000

# Optional: Resend API key for emailed password/PIN reset codes.
# Without it, codes are printed in the server log.
RESEND_API_KEY=
# Optional: sender address (needs a verified domain in Resend; default works for your own inbox)
MAIL_FROM=

# Voice assistant (all optional, comma-separated key lists; missing keys just disable that provider)
ASSEMBLYAI_API_KEYS=
GEMINI_API_KEYS=
GROQ_API_KEYS=

# Voice assistant keys can also be numbered; they are used in order as fallbacks:
# GEMINI_API_KEY_1=...
# GEMINI_API_KEY_2=...
# GEMINI_API_KEY_3=...
# GROQ_API_KEY_1=...
# ASSEMBLYAI_API_KEY_1=...
